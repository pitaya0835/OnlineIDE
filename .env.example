# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Optional: default Gemini model used for chat
GEMINI_MODEL=gemini-2.5-flash

# Optional: server port
PORT=3000

# Optional: connect a Hugging Face model running on a Google Colab GPU
# (see colab/huggingface_gpu_server.ipynb). Both are printed by the notebook
# once it starts; leave unset if you're not using the "Hugging Face モデル
# (Colab GPU)" option in the model selector.
COLAB_ENDPOINT_URL=
COLAB_API_KEY=
